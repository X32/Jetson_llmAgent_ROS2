{
  "model": "qwen2.5:3b-instruct-q4_0",
  "options": {
    "num_ctx": 2048,
    "temperature": 0.1,
    "top_p": 0.9,
    "repeat_penalty": 1.15
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "move_forward",
        "description": "控制小车向前移动指定距离（米）。参数应为正数，建议范围 0.1~5.0 米。",
        "parameters": {
          "type": "object",
          "properties": {
            "distance": {
              "type": "number",
              "description": "移动距离（米），必须 > 0，用阿拉伯数字（如 1.5）",
              "minimum": 0.1,
              "example": 1.0
            }
          },
          "required": ["distance"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "turn_left",
        "description": "控制小车原地左转指定角度（度）。参数应为正数，建议范围 1~360 度。",
        "parameters": {
          "type": "object",
          "properties": {
            "angle": {
              "type": "number",
              "description": "旋转角度（度），必须 > 0，用阿拉伯数字（如 90，不要写九十）",
              "minimum": 1,
              "example": 90
            }
          },
          "required": ["angle"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "turn_right",
        "description": "控制小车原地右转指定角度（度）。参数应为正数，建议范围 1~360 度。",
        "parameters": {
          "type": "object",
          "properties": {
            "angle": {
              "type": "number",
              "description": "旋转角度（度），必须 > 0，用阿拉伯数字（如 90，不要写九十）",
              "minimum": 1,
              "example": 45
            }
          },
          "required": ["angle"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "stop",
        "description": "立即停止小车运动。无参数。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "query_sensor",
        "description": "查询传感器数据（模拟）。返回模拟的障碍物距离。type 参数：'lidar'=雷达，'camera'=相机。",
        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["lidar", "camera"],
              "description": "传感器类型：'lidar'=激光雷达，'camera'=相机"
            }
          },
          "required": ["type"]
        }
      }
    }
  ]
}
