<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xxsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>action_demo</name>
  <version>0.0.1</version>
  <description>MoveRobot action实验：Goal/Feedback/Result三通道演示</description>
  <maintainer email="x32skykid@hotmail.com">x32</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 接口生成 -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>action_msgs</depend>
  <depend>opencv2</depend>

  <!-- 接口运行时 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
